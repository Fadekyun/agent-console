#!/usr/bin/env bash
set -euo pipefail
if [[ -n "${AGENT_CONSOLE_CONTEXT_FILE:-}" ]]; then
  : "${CMD_API_KEY:?selected CommandCode credential is missing}"
fi
unset PYTHONPATH PYTHONHOME
# Console's session launcher sources the selected credential. Native Hermes
# resolves ${CMD_API_KEY} from its session config; no hardcoded provider secret.
if [[ -n "${AGENT_CONSOLE_CONTEXT_FILE:-}" ]]; then
  HERMES_EPHEMERAL_SYSTEM_PROMPT="$(cat -- "$AGENT_CONSOLE_CONTEXT_FILE")"
  export HERMES_EPHEMERAL_SYSTEM_PROMPT
fi
hermes_root="${AGCONSOLE_HERMES_ROOT:-$HOME/.hermes/hermes-agent}"
exec "$hermes_root/venv/bin/python" -c 'import sys; sys.path.insert(0, sys.argv.pop(1)); from hermes_cli.main import main; main()' "$hermes_root" "$@"
