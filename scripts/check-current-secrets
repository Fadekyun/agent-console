#!/usr/bin/env python3
from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path


PATTERN = re.compile(
    r"^\s*(?:export\s+)?(?:OPENROUTER_API_KEY|OPENAI_API_KEY|NVIDIA_API_KEY)\s*=\s*[^$\s][^\s]*",
    re.MULTILINE,
)

EXCLUDE_DIRS = frozenset({
    ".git", ".venv", "venv", "node_modules", "__pycache__",
    ".pytest_cache", "test-results", "playwright-report",
    "secrets.d", "config", "data",
})

EXCLUDE_SUFFIXES = frozenset({
    ".egg-info", ".sqlite3", ".db", ".env", ".tmp",
})


def _skip_path(path: Path, root: Path) -> bool:
    rel = path.relative_to(root)
    parts = rel.parts
    if any(p in EXCLUDE_DIRS for p in parts):
        return True
    if path.suffix in EXCLUDE_SUFFIXES:
        return True
    return False


def _collect_tracked(root: Path) -> list[Path]:
    result = subprocess.run(
        ["git", "-c", f"safe.directory={root}", "-C", str(root),
         "rev-parse", "--is-inside-work-tree"],
        capture_output=True, text=True,
    )
    if result.returncode == 0 and result.stdout.strip() == "true":
        out = subprocess.run(
            ["git", "-c", f"safe.directory={root}", "-C", str(root),
             "ls-files", "-z"],
            check=True, capture_output=True,
        )
        files: list[Path] = []
        for raw in out.stdout.split(b"\0"):
            if not raw:
                continue
            p = root / raw.decode()
            if p.is_file():
                files.append(p)
        return files

    files = []
    for p in root.rglob("*"):
        if not p.is_file():
            continue
        if _skip_path(p, root):
            continue
        files.append(p)
    return files


def main() -> int:
    root = Path(__file__).resolve().parents[1]
    files = _collect_tracked(root)
    failures = []
    for path in files:
        if PATTERN.search(path.read_text(encoding="utf-8", errors="ignore")):
            failures.append(str(path.relative_to(root)))
    if failures:
        print("literal provider secret assignments found:", file=sys.stderr)
        for path in failures:
            print(f"  {path}", file=sys.stderr)
        return 1
    print("current tracked files contain no literal provider secret assignments")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
