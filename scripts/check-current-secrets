#!/usr/bin/env python3
from __future__ import annotations

import re
import subprocess
import sys
from pathlib import Path


PATTERN = re.compile(
    r"^\s*(?:export\s+)?(?:OPENROUTER_API_KEY|OPENAI_API_KEY|NVIDIA_API_KEY)\s*=\s*[^$\s][^\s]*",
    re.MULTILINE,
)


def main() -> int:
    root = Path(__file__).resolve().parents[1]
    result = subprocess.run(
        ["git", "-c", f"safe.directory={root}", "-C", str(root), "ls-files", "-z"],
        check=True,
        capture_output=True,
    )
    failures = []
    for raw in result.stdout.split(b"\0"):
        if not raw:
            continue
        path = root / raw.decode()
        if path.is_file() and PATTERN.search(path.read_text(encoding="utf-8", errors="ignore")):
            failures.append(str(path.relative_to(root)))
    if failures:
        print("literal provider secret assignments found:", file=sys.stderr)
        for path in failures:
            print(f"  {path}", file=sys.stderr)
        return 1
    print("current tracked files contain no literal provider secret assignments")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
