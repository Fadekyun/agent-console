#!/usr/bin/env bash
set -euo pipefail
SOURCE="$(python3 -P -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SOURCE")/.." && pwd)"
export PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}"
if [[ "${TERM:-dumb}" == "dumb" ]]; then
  export TERM=xterm-256color
fi
AGENT_CONSOLE_ENV_FILE="${AGENT_CONSOLE_ENV_FILE:-$HOME/.config/agent-console/runtime.env}"
if [[ -r "$AGENT_CONSOLE_ENV_FILE" ]]; then
  runtime_exports="$(python3 -P -B "$ROOT/scripts/maintenance.py" environment "$AGENT_CONSOLE_ENV_FILE")"
  eval "$runtime_exports"
fi
runtime_python="$ROOT/.runtime/bin/python"
if [ ! -x "$runtime_python" ]; then runtime_python=python3; fi
exec "$runtime_python" -P -B -m agent_console.selector "$@"
