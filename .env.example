# Agent Console Configuration
# Copy to .env and edit as needed. All values shown are defaults.

# Workspace root for repos, profiles, and handoffs
# AGENT_CONSOLE_WORKSPACE_ROOT=.

# State directory (SQLite DB, launchers, transcripts)
# AGENT_CONSOLE_STATE_DIR=~/.local/share/agent-console

# Database path
# AGENT_CONSOLE_DB=

# Tailscale identity email for web auth
# AGENT_CONSOLE_TAILSCALE_LOGIN=your-email@example.com

# Trusted LAN network (set to your LAN CIDR for LAN access)
# AGENT_CONSOLE_LAN_CIDR=127.0.0.1/32

# TrustedHostMiddleware allowlist (comma-separated)
# AGENT_CONSOLE_TRUSTED_HOSTS=localhost,127.0.0.1

# Bind host for uvicorn (set 0.0.0.0 for Docker, 127.0.0.1 for native)
# AGENT_CONSOLE_BIND_HOST=127.0.0.1

# Max WebSocket PTY clients per session
# AGENT_CONSOLE_MAX_PTY_CLIENTS=2

# Max managed sessions
# AGENT_CONSOLE_MAX_SESSIONS=12

# Max children per parent session
# AGENT_CONSOLE_MAX_CHILDREN=3

# Tool binary paths (relies on PATH if not set)
# AGCONSOLE_CODEX_BIN=codex
# AGCONSOLE_CLAUDE_BIN=claude
# AGCONSOLE_OPENCODE_BIN=opencode
# AGCONSOLE_HERMES_BIN=hermes
# AGCONSOLE_SHELL_BIN=/usr/bin/zsh

# Skills root directory
# AGCONSOLE_SKILLS_ROOT=~/codex/skills

# Comma-separated skill names to sync (empty = no skills)
# AGCONSOLE_RETAINED_SKILLS=

# Tunnel host for reverse SSH tunnel
# AGENT_CONSOLE_TUNNEL_HOST=localhost

# Profile directory (agent role markdown files)
# AGENT_CONSOLE_PROFILE_DIR=

# Handoff/plan artifact directory
# AGENT_CONSOLE_HANDOFF_DIR=

# Worktree root directory
# AGENT_CONSOLE_WORKTREE_ROOT=

# tmux socket name (mutually exclusive with socket path)
# AGENT_CONSOLE_TMUX_SOCKET=

# tmux socket path
# AGENT_CONSOLE_TMUX_SOCKET_PATH=/run/user/1000/agent-console/tmux.sock

# Legacy tmux socket path
# AGENT_CONSOLE_LEGACY_TMUX_SOCKET_PATH=/tmp/tmux-1000/default

# Auth/secrets config directory
# AGENT_CONSOLE_CONFIG_DIR=~/.config/agent-console
