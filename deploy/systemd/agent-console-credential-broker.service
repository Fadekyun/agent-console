[Unit]
Description=Agent Console private credential broker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agent-console-broker
Group=agent-console-broker
# Install agent-console[web] into this dedicated, root-owned virtual environment.
WorkingDirectory=/opt/agent-console-broker
Environment=BROKER_PORT=8792
LoadCredential=admin-token:/etc/agent-console-broker/admin-token
ExecStart=/opt/agent-console-broker/bin/python -m agent_console.credential_broker --state-dir /var/lib/agent-console-broker --admin-token-file %d/admin-token --port ${BROKER_PORT}
StateDirectory=agent-console-broker
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
LockPersonality=true

[Install]
WantedBy=multi-user.target
