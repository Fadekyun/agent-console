[Unit]
Description=Agent Console reverse tunnel to tunnel-host
After=network-online.target agent-console-web.service
Wants=network-online.target agent-console-web.service

[Service]
Type=simple
ExecStart=/usr/bin/ssh -N -T -o BatchMode=yes -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -R 127.0.0.1:13210:your-lan-ip:3210 your-tunnel-host
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=default.target
